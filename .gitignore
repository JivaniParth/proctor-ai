# ═══════════════════════════════════════════════════════════════════════════════
# ProctorAI — Root .gitignore
# Covers the entire monorepo (frontend + backend)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Environment / secrets (NEVER commit these) ────────────────────────────────
.env
.env.local
.env.*
.env.example
*.secret
secrets.json
credentials.json
service-account*.json

# ─── Frontend (Node / Vite) ────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
build/
out/
.vite/
*.local
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Backend (Python / FastAPI) ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
venv/
.venv/
env/
.env/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover
.mypy_cache/
.ipynb_checkpoints/

# ─── Database / local storage ──────────────────────────────────────────────────
*.db
*.sqlite3
*.sqlite

# ─── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
ehthumbs.db

# ─── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.bak

# ─── Misc ──────────────────────────────────────────────────────────────────────
*.orig
*.rej
*.patch
